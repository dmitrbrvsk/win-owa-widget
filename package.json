{
    "name": "win-owa-widget",
    "productName": "OWA Widget",
    "version": "1.5.0",
    "description": "Exchange / OWA meetings in the Windows tray: timeline, one-click join, reminders, RSVP",
    "author": "Dmitry Borovskiy",
    "license": "MIT",
    "private": true,
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:demo": "node scripts/dev.mjs --demo",
        "build": "yarn typecheck && node scripts/build-main.mjs && vite build",
        "build:main": "node scripts/build-main.mjs",
        "build:renderer": "vite build",
        "build:browser-demo": "vite build --mode browser-demo",
        "start": "electron .",
        "start:demo": "cross-env OWA_DEMO=1 electron .",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "test": "vitest run",
        "dist": "yarn build && electron-builder --win nsis zip --x64 --publish never && electron-builder --win nsis --arm64 --config electron-builder.arm64.yml --publish never",
        "setup:electron": "node node_modules/electron/install.js",
        "lint:styles": "arui-presets-lint styles --max-warnings=0",
        "lint:scripts": "arui-presets-lint scripts --max-warnings=0",
        "format": "arui-presets-lint format",
        "format:check": "arui-presets-lint format:check",
        "lint": "yarn lint:styles && yarn lint:scripts && yarn format:check",
        "lint:fix": "yarn lint:styles --fix && yarn lint:scripts --fix && yarn format"
    },
    "devDependencies": {
        "@electron/fuses": "1.8.0",
        "@modelcontextprotocol/server": "2.3.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^5.0.0",
        "arui-presets-lint": "11.2.1",
        "cross-env": "^7.0.3",
        "electron": "^44.6.0",
        "electron-builder": "^26.0.0",
        "esbuild": "^0.25.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.0",
        "vitest": "^5.0.3",
        "zod": "4.6.7"
    },
    "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
    "engines": {
        "node": ">=24.22.0 <25"
    },
    "prettier": "arui-presets-lint/prettier",
    "stylelint": {
        "extends": "arui-presets-lint/stylelint",
        "overrides": [
            {
                "files": [
                    "src/renderer/**/*.css"
                ],
                "rules": {
                    "stylelint-core-vars/use-vars": null,
                    "stylelint-core-vars/use-mixins": null,
                    "stylelint-core-vars/use-one-of-vars": null,
                    "stylelint-core-vars/use-one-of-mixins": null,
                    "stylelint-core-vars/do-not-use-dark-colors": null
                }
            }
        ]
    },
    "resolutions": {
        "braces@npm:^3.0.3": "patch:braces@npm%3A3.0.3#~/.yarn/patches/braces-npm-3.0.3-582c14023c.patch",
        "sprintf-js@npm:^1.1.2": "patch:sprintf-js@npm%3A1.1.3#~/.yarn/patches/sprintf-js-npm-1.1.3-b99efd75b2.patch",
        "katex@npm:^0.16.0": "npm:0.18.2"
    }
}
